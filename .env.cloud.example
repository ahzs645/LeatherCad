# Copy to .env.local (ignored), then supply existing project/client values.
# These are public browser/build identifiers. Empty values keep cloud disabled.
VITE_CONVEX_URL=
VITE_CONVEX_HTTP_URL=
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_BASE_PATH=/

# Operations-only: full deployed editor directory URL, including its base path.
# The generated callback must be registered on the existing OIDC SPA client.
LEATHERCAD_CLOUD_EDITOR_URL=

# Select an EXISTING dev:name, prod:name or preview:name deployment.
CONVEX_DEPLOYMENT=

# These declarations must also be configured on the selected backend.
# Built-in sign-in sends an ID token: audience equals the public SPA client ID.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
# Convex normally supplies CONVEX_SITE_URL on the backend automatically.
CONVEX_SITE_URL=

# Configure CLI authorization through your secret store or existing CLI session.
# Never prefix credentials with VITE_, commit them, or put tokens in CLI arguments.
# CONVEX_DEPLOY_KEY=
# CONVEX_ACCESS_TOKEN=

# Live smoke reads two short-lived application ID tokens from environment or files.
# Use dedicated TEST accounts/deployment; write smoke publishes a synthetic pattern
# briefly, then retires it. License metadata and a discussion tombstone remain.
# LEATHERCAD_CLOUD_SMOKE_TOKEN_A=
# LEATHERCAD_CLOUD_SMOKE_TOKEN_B=
# LEATHERCAD_CLOUD_SMOKE_TOKEN_A_FILE=
# LEATHERCAD_CLOUD_SMOKE_TOKEN_B_FILE=
