{
  "name": "leathercad",
  "private": true,
  "version": "0.0.0",
  "bin": {
    "leathercad": "./scripts/leathercad-agent-server.mjs"
  },
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-engine-pair.mjs && tsc -b && vite build && node scripts/verify-engine-pair.mjs --write",
    "agent": "pnpm run build && node scripts/leathercad-agent-server.mjs",
    "agent:serve": "node scripts/leathercad-agent-server.mjs",
    "typecheck": "tsc -b && tsc --noEmit -p convex/tsconfig.json",
    "typecheck:cloud": "tsc --noEmit -p convex/tsconfig.json",
    "typecheck:backend": "tsc --noEmit -p convex/tsconfig.json",
    "lint": "eslint .",
    "check:architecture": "node scripts/check-file-size.mjs",
    "render:ai-builder-benchmarks": "node scripts/render-ai-builder-benchmarks.mjs",
    "pattern:pdf": "node scripts/import-pattern-pdf.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ai-builder-benchmarks": "vitest run src/features/editor/ai-builder/ai-builder-benchmark.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ai-builder-functional": "vitest run src/features/editor/ai-builder/ai-builder-functional.test.ts",
    "check:engine": "node scripts/verify-engine-pair.mjs",
    "test:release": "playwright test --config playwright.release.config.ts",
    "audit:localization": "node scripts/audit-localization.mjs --out docs/verification/localization-coverage.json --check-core",
    "calibration:print": "node scripts/generate-print-calibration.mjs",
    "test:webkit": "playwright test --config playwright.webkit.config.ts",
    "cloud:preflight": "node scripts/cloud-preflight.mjs",
    "cloud:codegen": "node scripts/cloud-preflight.mjs --codegen",
    "cloud:smoke": "node scripts/cloud-smoke.mjs",
    "test:cloud-readiness": "node --test scripts/cloud-readiness.test.mjs",
    "calibration:stl": "node scripts/generate-stl-calibration.mjs"
  },
  "dependencies": {
    "@atelier/core": "link:../atelier/packages/core",
    "@atelier/geometry": "link:../atelier/packages/geometry",
    "@atelier/io": "link:../atelier/packages/io",
    "@atelier/react": "link:../atelier/packages/react",
    "@atelier/render": "link:../atelier/packages/render",
    "@atelier/sim": "link:../atelier/packages/sim",
    "@atelier/viewport": "link:../atelier/packages/viewport",
    "@convex-dev/rate-limiter": "^0.4.3",
    "clipper-lib": "^6.4.2",
    "convex": "^1.49.0",
    "convex-helpers": "^0.1.133",
    "dexie": "^4.4.2",
    "manifold-3d": "3.5.4",
    "oidc-client-ts": "^3.5.0",
    "opentype.js": "^1.3.4",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.183.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.59.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.184.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "convex-test": "^0.0.66",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "happy-dom": "^20.8.3",
    "sass": "^1.97.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
