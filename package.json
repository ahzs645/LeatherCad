{
  "name": "leathercad",
  "private": true,
  "version": "0.0.0",
  "bin": {
    "leathercad": "./scripts/leathercad-agent-server.mjs"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "agent": "npm run build && node scripts/leathercad-agent-server.mjs",
    "agent:serve": "node scripts/leathercad-agent-server.mjs",
    "lint": "eslint .",
    "check:architecture": "node scripts/check-file-size.mjs",
    "render:ai-builder-benchmarks": "node scripts/render-ai-builder-benchmarks.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ai-builder-benchmarks": "vitest run src/features/editor/ai-builder/ai-builder-benchmark.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "dexie": "^4.4.2",
    "opentype.js": "^1.3.4",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.183.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "happy-dom": "^20.8.3",
    "sass": "^1.97.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
