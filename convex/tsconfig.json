{
  "compilerOptions": {
    "allowJs": true, "strict": true, "target": "ESNext", "lib": ["ES2022", "DOM"],
    "module": "ESNext", "moduleResolution": "Bundler", "skipLibCheck": true,
    "isolatedModules": true, "noEmit": true, "types": ["node"]
  },
  "include": ["./**/*"], "exclude": ["./_generated"]
}
